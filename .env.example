# ==============================================================================
# BarangayConnect Hotline — Environment Variables
# Copy this file to .env.local and fill in the values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# NEVER commit real secrets. See .gitignore.
# ==============================================================================

# ---- Database (local prototype: SQLite) ------------------------------------
DATABASE_URL="file:./dev.db"

# ---- Supabase (used in a later phase for auth / storage / Postgres) ---------
# When you create a free project at https://supabase.com, paste your values here.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Telephony provider (Phase 10 — future real integration) ---------------
# Do NOT hardcode these in the app. Only the server may read them.
TELEPHONY_PROVIDER="none"
TELEPHONY_ACCOUNT_ID=""
TELEPHONY_AUTH_TOKEN=""
TELEPHONY_PHONE_NUMBER="+63XXXXXXXXXX"

# ---- Demo / app config ------------------------------------------------------
APP_ENV="development"

# ---- Session signing secret (required for production) -----------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"